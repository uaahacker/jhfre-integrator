# This file is a variable-NAME reference only. It is documentation, not
# configuration: the application does NOT load it automatically. Supply real
# values through the process environment, Docker/container environment,
# deployment platform secrets, a service manager's environment block, or an
# approved secret store. Never put real secrets in this file or in Git.
#
# Everything in this file is DEPLOYMENT-WIDE configuration. It has nothing to
# do with any individual SAML/OIDC provider. SSO providers (SAML/OIDC) are
# configured through the SSO management UI and persisted in the database —
# see docs/sso.md. Adding a supported provider after deployment never
# requires changing this file, restarting with new variables, or editing any
# source file.

# ======================================================================
# REQUIRED SECRETS
# ======================================================================
# Required in every environment; startup fails without real values.
#
# Both keys must stay IDENTICAL across process restarts and across every
# instance of a given deployment. Django signs session cookies with
# DJANGO_SECRET_KEY, so changing it invalidates every existing session
# (logged-in users get signed out; the session backend logs "Session data
# corrupted" for the now-unverifiable old cookies -- this is expected
# signature-verification behavior, not an error to fix in code). SSO secrets
# are encrypted at rest with DJANGO_ENCRYPTION_KEY, so changing it makes
# previously stored SSO provider secrets undecryptable. Generate each value
# once per deployment and keep it stable (e.g. in the deployment's secret
# store), rather than regenerating it on every restart or redeploy.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ENCRYPTION_KEY=CHANGE_ME

# ======================================================================
# LOCAL DEVELOPMENT
# ======================================================================
# Set true explicitly for local development. Omit or set false for
# production, so DEBUG can never be accidentally left on in a deployment.
DJANGO_DEBUG=true

# ======================================================================
# HOST / CSRF
# ======================================================================
# Comma-separated hostnames/IPs only (no scheme, no wildcards). Required
# when DJANGO_DEBUG is false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated full origins (scheme://host[:port]). Only needed when a
# deployment's proxy/HTTPS topology makes the browser's Origin/Referer header
# not match DJANGO_ALLOWED_HOSTS on its own. Empty/unset is valid and is the
# common case.
DJANGO_CSRF_TRUSTED_ORIGINS=

# ======================================================================
# SESSION COOKIE POLICY
# ======================================================================
# SameSite must be exactly Lax, Strict, or None. None requires Secure=true
# (rejected at startup otherwise — this is also a real browser rule, not
# just a style preference).
#
# Local HTTP development:
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_SECURE=false
#
# HTTPS SAML deployment (uncomment together, and comment out the pair
# above): a cross-site SAML ACS POST (IdP -> browser -> Django) needs the
# session cookie to survive that cross-site POST, which needs SameSite=None
# with Secure=true, served over real HTTPS.
# DJANGO_SESSION_COOKIE_SAMESITE=None
# DJANGO_SESSION_COOKIE_SECURE=true

# ======================================================================
# HTTPS / REVERSE PROXY
# ======================================================================
# Opt-in because a reverse-proxy topology must be known. Only trust
# X-Forwarded-Proto when the deployment's proxy actually sets it.
# FORCE_HTTPS remains a backwards-compatible alias for
# DJANGO_SECURE_SSL_REDIRECT. SSO_FORCE_HTTPS separately controls how SSO
# callback URLs are constructed.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_X_FORWARDED_PROTO=true
# DJANGO_ENABLE_HSTS=true
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# SSO_FORCE_HTTPS=true

# Production web servers must deny direct /media/uploads/ access. Submitted
# files are served only through Django's protected download endpoint.

# ======================================================================
# DATABASE
# ======================================================================
# Optional. When omitted, Django uses the local SQLite db.sqlite3 fallback.
# For production, configure PostgreSQL (or another supported primary DB).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ======================================================================
# EXTERNAL DATABASE LIMITS
# ======================================================================
# Optional bounded external stored-procedure execution settings.
# EXTERNAL_DB_PROCEDURE_TIMEOUT=30
# EXTERNAL_DB_PROCEDURE_MAX_ROWS_PER_RESULT_SET=100
# EXTERNAL_DB_PROCEDURE_MAX_RESULT_SETS=5
# EXTERNAL_DB_PROCEDURE_MAX_TOTAL_ROWS=500

# ======================================================================
# LEGACY SAML CONFIGURATION — NOT USED FOR NEW sso_auth PROVIDERS
# ======================================================================
# These variables are read only by core/saml/settings.py, which is consumed
# only by the legacy `saml_auth` app. `saml_auth`'s URLs are commented out
# in core/urls.py and are not routable — this app is kept installed solely
# because an sso_auth migration depends on its migration history (see
# docs/sso.md and docs/project-structure.md). They have no effect on the
# active sso_auth SAML/OIDC implementation.
#
# Do NOT set these to add a new SAML provider. Normal provider onboarding is:
# SSO Configuration -> Add Provider -> SAML 2.0 -> paste metadata -> enable.
# Supply files outside Git only if this legacy path is ever exercised.
# SAML_SP_PRIVATE_KEY_PATH=/run/secrets/saml-sp-private.key
# SAML_SP_CERT_PATH=/run/secrets/saml-sp-public.cert
# SAML_IDP_CERT_PATH=/run/secrets/saml-idp-cert.pem
# SAML_SP_ENTITY_ID=https://app.example.com/saml/metadata/
# SAML_SP_ACS_URL=https://app.example.com/saml/acs/
# SAML_SP_SLO_URL=https://app.example.com/saml/logout/
# SAML_IDP_ENTITY_ID=https://idp.example.com/entity
# SAML_IDP_SSO_URL=https://idp.example.com/sso
# SAML_IDP_SLO_URL=https://idp.example.com/slo
# SAML_STRICT=true
# SAML_DEBUG=false
